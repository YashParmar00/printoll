# ============================================================================
# AuraaMarts environment variables — copy to .env.local and fill real values.
# .env.local is git-ignored; NEVER commit real secrets.
# ============================================================================

# ---- Razorpay (payments) ----------------------------------------------------
# These are PLACEHOLDERS. Get real TEST keys from:
#   Razorpay Dashboard → Settings → API Keys → (Test Mode) → Generate.
# Swap the four values below; the integration code does NOT change — only keys.
# Server-only secrets (no NEXT_PUBLIC_ prefix → never sent to the browser):
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET_swap_me
# Set this when you configure the webhook in the Razorpay dashboard:
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET_swap_me
# Public key id (safe to expose to the browser — used by Razorpay Checkout):
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER

# ---- Admin panel (HTTP Basic auth) -----------------------------------------
# Protects /admin. Pick a strong password before deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# ---- Database (Supabase Postgres + Prisma) ---------------------------------
# From Supabase → Project → Connect. The APP uses the TRANSACTION pooler
# (port 6543, add ?pgbouncer=true); MIGRATIONS use the SESSION pooler (5432).
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Product image uploads (Supabase Storage) ------------------------------
# Create a PUBLIC bucket named `product-images` in Supabase Storage. Get the
# Project URL + service_role secret from Supabase → Settings → API. Never expose
# the service role key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ---- Later milestones (not used yet) ---------------------------------------
# RESEND_API_KEY=              # order confirmation emails
# Photo-upload storage (Supabase Storage / Cloudinary) — TBD
